# Local: copie para .env.local. Nunca publique APP_MODE=sandbox.
APP_MODE=sandbox
APP_ORIGIN=http://127.0.0.1:3000
# Defina valor aleatório estável >=32 caracteres (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
SESSION_SECRET=
# Chave separada recomendada para criptografar CPF/CNPJ e chaves Pix no banco.
DATA_ENCRYPTION_KEY=
# Token aleatório para o endpoint de manutenção agendada.
CRON_SECRET=
# LOCAL_DATABASE_PATH=.local/db

# Produção: APP_MODE=production, origem HTTPS e conexão PostgreSQL privada.
DATABASE_URL=
# Definida automaticamente pela integração Supabase/Vercel e preferida em produção.
POSTGRES_URL=
# CA confiável do seu provedor se necessário; use \n para novas linhas. Nunca desabilite verificação TLS.
DATABASE_SSL_CA=
NEXT_PUBLIC_SUPABASE_URL=
# Alias público útil quando NEXT_PUBLIC_SUPABASE_URL já existe como segredo legado na Vercel.
NEXT_PUBLIC_SUPABASE_PROJECT_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEPIX_API_KEY=
DEPIX_WEBHOOK_SECRET=

# Opcional: iniciação Pix oficial que abre o banco no mobile. A DePix continua liquidando a cobrança.
# Ative primeiro em homologação; o certificado P12 deve ser codificado em Base64 e permanecer só no backend.
EFI_OPEN_FINANCE_ENABLED=false
EFI_OPEN_FINANCE_ENV=homologation
EFI_OPEN_FINANCE_CLIENT_ID=
EFI_OPEN_FINANCE_CLIENT_SECRET=
EFI_OPEN_FINANCE_P12_BASE64=
EFI_OPEN_FINANCE_P12_PASSPHRASE=
