# Local: copie para .env.local. Nunca publique APP_MODE=sandbox.
APP_MODE=sandbox
APP_ORIGIN=http://127.0.0.1:3000
# Defina valor aleatório estável >=32 caracteres (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
SESSION_SECRET=
# LOCAL_DATABASE_PATH=.local/db

# Produção: APP_MODE=production, origem HTTPS e conexão PostgreSQL privada.
DATABASE_URL=
# CA confiável do seu provedor se necessário; use \n para novas linhas. Nunca desabilite verificação TLS.
DATABASE_SSL_CA=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
